<?php 
    include "../../conn.php";
    include "../../functions2.php";

    // Enable error reporting for debugging
    ini_set('display_errors', 1);
    ini_set('display_startup_errors', 1);
    error_reporting(E_ALL);

    // Set headers for the response
    header('Content-Type: application/json; charset=utf-8');
    header('Strict-Transport-Security: max-age=31536000');
    header('Access-Control-Allow-Headers: Origin, X-Requested-With, Content-Type, Accept, Authorization');
    header('Access-Control-Allow-Credentials: true');
    $origin = isset($_SERVER['HTTP_ORIGIN']) ? $_SERVER['HTTP_ORIGIN'] : '';
    header('Access-Control-Allow-Origin: ' . $origin);
    header('vary: Origin');

    date_default_timezone_set("Asia/Kolkata");
    $shnunc = date("Y-m-d H:i:s");
    $res = [
        'code' => 0,
        'msg' => 'Method not allowed',
        'msgCode' => 0,
        'serviceNowTime' => $shnunc,
    ];

    $shonubody = file_get_contents("php://input");
    $shonupost = json_decode($shonubody, true);

    if ($_SERVER['REQUEST_METHOD'] != 'GET') {
        if (isset($shonupost['language']) && isset($shonupost['random']) && isset($shonupost['signature']) && isset($shonupost['timestamp'])) {
            $language = htmlspecialchars(mysqli_real_escape_string($conn, $shonupost['language']));
            $random = htmlspecialchars(mysqli_real_escape_string($conn, $shonupost['random']));
            $signature = htmlspecialchars(mysqli_real_escape_string($conn, $shonupost['signature']));
            $shonustr = '{"language":'.$language.',"random":"'.$random.'"}';
            $shonusign = strtoupper(md5($shonustr));

            if ($shonusign == $signature) {
                $bearer = explode(" ", $_SERVER['HTTP_AUTHORIZATION']);
                $author = $bearer[1];
                $is_jwt_valid = is_jwt_valid($author);
                $data_auth = json_decode($is_jwt_valid, 1);

                if ($data_auth['status'] === 'Success') {
                    $sesquery = "SELECT akshinak, codechorkamukala, userPhoto, email, emailverify, shonullgnt FROM shonu_subjects WHERE akshinak = '$author'";
                    $sesresult = $conn->query($sesquery);
                    if ($sesresult && mysqli_num_rows($sesresult) == 1) {
                        $row = $sesresult->fetch_assoc();
                        $userId = (int)$data_auth['payload']['id'];

                        // Default user photo if empty
                        $userPhoto = !empty($row['userPhoto']) ? $row['userPhoto'] : 'https://joshgame.online/assets/png/1-a6662edb.png';

                        $data = [
                            'userId' => $userId,
                            'userPhoto' => $userPhoto,
                            'userName' => '91' . $data_auth['payload']['mobile'],
                            'nickName' => $row['codechorkamukala'],
                            'userLoginDate' => $row['shonullgnt'], // Last Login Date
                        ];

                        // Balance
                        $balquery = "SELECT motta FROM shonu_kaichila WHERE balakedara = $userId";
                        $balresult = $conn->query($balquery);
                        $balarr = mysqli_fetch_array($balresult);
                        $data['amount'] = $balarr['motta'];

                        // USDT Rate
                        $query = "SELECT rate FROM tbl_pg WHERE value = 'usdt' LIMIT 1";
                        $result = $conn->query($query);
                        $row = $result->fetch_assoc();
                        $data['uRate'] = (float)$row['rate'];

                        // Unread Notifications
                        $countQuery = "SELECT COUNT(*) AS total_notifications FROM notification WHERE user_id = $userId AND state = 0";
                        $countResult = $conn->query($countQuery);
                        $unRead = $countResult ? (int)$countResult->fetch_assoc()['total_notifications'] : 0;
                        $data['unRead'] = $unRead;

                        // Additional Data
                        $data['addTime'] = $shnunc;
                        $data['sign'] = strtoupper(hash('sha256', json_encode($data)));

                        $res['data'] = $data;
                        $res['code'] = 0;
                        $res['msg'] = 'Succeed';
                        $res['msgCode'] = 0;
                        http_response_code(200);
                        echo json_encode($res);
                    } else {
                        $res['code'] = 4;
                        $res['msg'] = 'No operation permission';
                        $res['msgCode'] = 2;
                        http_response_code(401);
                        echo json_encode($res);
                    }
                } else {
                    $res['code'] = 4;
                    $res['msg'] = 'No operation permission';
                    $res['msgCode'] = 2;
                    http_response_code(401);
                    echo json_encode($res);
                }
            } else {
                $res['code'] = 5;
                $res['msg'] = 'Wrong signature';
                $res['msgCode'] = 3;
                http_response_code(200);
                echo json_encode($res);
            }
        } else {
            $res['code'] = 7;
            $res['msg'] = 'Param is Invalid';
            $res['msgCode'] = 6;
            http_response_code(200);
            echo json_encode($res);
        }
    } else {
        $res['code'] = 11;
        $res['msg'] = 'Method not allowed';
        $res['msgCode'] = 12;
        http_response_code(405);
        echo json_encode($res);
    }
?>
