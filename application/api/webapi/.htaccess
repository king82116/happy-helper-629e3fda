RewriteEngine On

#########################################
# 🔐 ALLOW WEBHOOK DIRECT ACCESS (NO REDIRECT)
#########################################
RewriteCond %{REQUEST_URI} ^/application/api/webapi/ProxyBalanceWebhook\.php$ [NC]
RewriteRule .* - [L]

#########################################
# 🔒 FORCE HTTPS (SAFE – webhook excluded)
#########################################
RewriteCond %{HTTPS} !=on
RewriteRule ^/?(.*)$ https://%{SERVER_NAME}/$1 [R=301,L]

#########################################
# 🛠 Fix missing Authorization header
#########################################
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

#########################################
# 🌐 API endpoints: keep .php extension
#########################################
# The frontend JS calls /application/api/webapi/*.php directly.
# A 301 redirect to extensionless URLs strips the POST body
# (browsers convert POST → GET on 301), which broke MotoRaceBet
# and any other POST endpoint. So do NOT rewrite .php here.

# Internal rewrite /file → /file.php (still allow extensionless GETs to work)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]

#########################################
# 🚫 Remove index.php from URL
#########################################
RewriteCond %{REQUEST_URI} ^(.*/)index\.php$ [NC]
RewriteRule . https://%{HTTP_HOST}%1 [R=301,NE,L]

#########################################
# ❌ 404 fallback
#########################################
ErrorDocument 404 /index.php
